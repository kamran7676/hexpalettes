---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getAllColors } from '../../lib/colors';
import { noindexColorSlugs } from '../../lib/color-routes.mjs';

export async function getStaticPaths() {
  const allColors = await getAllColors();
  const uniqueColors = [...new Map(allColors.map(color => [color.slug, color])).values()];
  return uniqueColors.map(color => ({ params: { slug: color.slug }, props: { color } }));
}
const { color } = Astro.props;
const displayName = color.name.replace(/\s+Color$/i, '');
const hex = color.hexCode;
const channels = [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16));
const [r, g, b] = channels;
const rgb = `rgb(${r}, ${g}, ${b})`;
const max = Math.max(r, g, b) / 255, min = Math.min(r, g, b) / 255;
const delta = max - min;
let hue = 0;
if (delta) hue = max === r / 255 ? ((g / 255 - b / 255) / delta) % 6 : max === g / 255 ? (b / 255 - r / 255) / delta + 2 : (r / 255 - g / 255) / delta + 4;
hue = (hue * 60 + 360) % 360;
const lightness = (max + min) / 2;
const saturation = delta ? delta / (1 - Math.abs(2 * lightness - 1)) : 0;
const hsl = `hsl(${Math.round(hue)}, ${Math.round(saturation * 100)}%, ${Math.round(lightness * 100)}%)`;
const k = 1 - max;
const cmyk = `${Math.round((1 - max - k) / (1 - k || 1) * 100)}%, ${Math.round((1 - g / 255 - k) / (1 - k || 1) * 100)}%, ${Math.round((1 - b / 255 - k) / (1 - k || 1) * 100)}%, ${Math.round(k * 100)}%`;
const hslColor = (h: number, s: number, l: number) => `hsl(${Math.round((h + 360) % 360)}, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%)`;
const related = [
  { name: 'Complementary', value: hslColor(hue + 180, saturation, lightness) },
  { name: 'Analogous', value: hslColor(hue + 30, saturation, lightness) },
  { name: 'Triadic', value: hslColor(hue + 120, saturation, lightness) },
];
const shades = [0.8, 0.6, 0.4].map(l => hslColor(hue, saturation, lightness * l));
const tints = [0.2, 0.4, 0.6].map(x => hslColor(hue, saturation, lightness + (1 - lightness) * x));
const title = `${displayName} Color Code: Hex, RGB, HSL, CMYK | HexPalettes`;
const description = `${displayName} color code: ${hex} in HEX and ${rgb}. View HSL ${hsl} and CMYK ${cmyk}, plus shades, tints, and color combinations.`;
const url = `https://hexpalettes.vercel.app/color/${color.slug}`;
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hexpalettes.vercel.app/' },
    { '@type': 'ListItem', position: 2, name: 'Colors', item: 'https://hexpalettes.vercel.app/colors' },
    { '@type': 'ListItem', position: 3, name: color.name, item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: `What is the hex code of ${color.name}?`, acceptedAnswer: { '@type': 'Answer', text: `The hex code of ${color.name} is ${hex}.` } },
    { '@type': 'Question', name: `What is the RGB value of ${color.name}?`, acceptedAnswer: { '@type': 'Answer', text: `The RGB value of ${color.name} is ${rgb}.` } },
  ] },
];
---
<Layout title={title} description={description} noindex={noindexColorSlugs.has(color.slug)} structuredData={structuredData}>
  <Navbar />
  <main class="container mx-auto px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-5xl">
      <nav class="mb-6 text-sm text-gray-500"><a href="/">Home</a> / <a href="/colors">Colors</a> / {color.name}</nav>
      <h1 class="mb-6 text-4xl font-bold text-gray-900 dark:text-white">{displayName} Color Code</h1>
      <div class="card overflow-hidden">
        <div class="h-64 sm:h-80" style={`background:${hex}`} aria-label={`${color.name} color swatch`}></div>
        <div class="grid gap-5 p-6 sm:grid-cols-2 lg:grid-cols-4">
          {[['HEX', hex], ['RGB', rgb], ['HSL', hsl], ['CMYK', cmyk]].map(([label, value]) => <div><h2 class="mb-2 text-sm font-semibold text-gray-500">{label}</h2><code class="font-mono text-gray-900 dark:text-white">{value}</code></div>)}
        </div>
      </div>
      <section class="py-8"><h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">{color.name} shades and tints</h2><div class="grid grid-cols-3 gap-3 sm:grid-cols-6">{[...shades, ...tints].map((value, i) => <div><div class="h-20 rounded-xl" style={`background:${value}`}></div><p class="mt-2 text-xs text-gray-500">{i < 3 ? 'Shade' : 'Tint'} · {i + 1}</p></div>)}</div></section>
      <section class="py-4"><h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">Colors related to {color.name}</h2><div class="grid gap-4 sm:grid-cols-3">{related.map(item => <div class="rounded-xl border border-gray-200 p-4 dark:border-white/10"><div class="mb-3 h-16 rounded-lg" style={`background:${item.value}`}></div><h3 class="font-semibold text-gray-900 dark:text-white">{item.name}</h3><code class="text-sm text-gray-500">{item.value}</code></div>)}</div></section>
      <section class="py-8"><h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">{color.name} color code FAQ</h2><h3 class="mb-2 text-lg font-semibold">What is the hex code of {color.name}?</h3><p class="mb-5 text-gray-600 dark:text-gray-300">The hex code of {color.name} is <code>{hex}</code>.</p><h3 class="mb-2 text-lg font-semibold">What is the RGB value of {color.name}?</h3><p class="text-gray-600 dark:text-gray-300">The RGB value of {color.name} is <code>{rgb}</code>.</p></section>
      <p class="pb-10"><a class="text-primary-600" href="/colors">Browse all colors</a></p>
    </div>
  </main>
</Layout>
