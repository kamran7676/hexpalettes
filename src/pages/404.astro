---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---
<Layout title="Page Not Found | HexPalettes" description="This page could not be found. Browse color palettes, look up color codes, and explore design inspiration from HexPalettes." noindex>
  <Navbar />
  <main class="container mx-auto px-4 py-20 text-center">
    <h1 class="mb-4 text-4xl font-bold text-gray-900 dark:text-white">404: Page not found</h1>
    <p class="mb-8 text-gray-600 dark:text-gray-300">That page may have moved. Explore color palettes or browse color codes instead.</p>
    <div class="flex justify-center gap-4"><a class="text-primary-600" href="/colors">Browse colors</a><a class="text-primary-600" href="/palettes">Explore palettes</a></div>
  </main>
</Layout>
