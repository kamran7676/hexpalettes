---
import '../index.css';
import Analytics from '@vercel/analytics/astro'

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  structuredData?: object[];
}

const { title, description = 'Discover beautiful color palettes, explore colors, and find inspiration for your next design project.', noindex = false, structuredData = [] } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title.length <= 60 ? title : `${title.slice(0, 57).replace(/\s+\S*$/, '')}...`;
const descriptionText = description.replace(/\s+/g, ' ').trim();
const extendedDescription = descriptionText.length < 120
  ? `${descriptionText.replace(/[.!?]?$/, '.') } Explore ${title.replace(/\s*[|—-]\s*HexPalettes\s*$/i, '')} color details, values, and related design ideas.`
  : descriptionText;
const pageDescription = extendedDescription.length <= 155
  ? extendedDescription
  : `${extendedDescription.slice(0, 152).replace(/\s+\S*$/, '')}...`;
const baseStructuredData = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'HexPalettes', url: Astro.site },
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'HexPalettes', url: Astro.site, applicationCategory: 'DesignApplication', operatingSystem: 'Any', description: pageDescription },
];
const breadcrumbs = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbStructuredData = breadcrumbs.length ? [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site },
    ...breadcrumbs.map((part, index) => ({
      '@type': 'ListItem', position: index + 2,
      name: index === breadcrumbs.length - 1 ? pageTitle.replace(/\s*[|—-]\s*HexPalettes\s*$/i, '') : part.replace(/-/g, ' ').replace(/\b\w/g, letter => letter.toUpperCase()),
      item: new URL(`/${breadcrumbs.slice(0, index + 1).join('/')}`, Astro.site),
    })),
  ],
}] : [];
const allStructuredData = [...baseStructuredData, ...breadcrumbStructuredData, ...structuredData];
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/hexpalettes.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {allStructuredData.map(data => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HexPalettes color palettes and color codes" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="HexPalettes color palettes and color codes" />

    <!-- Dark mode: prevent flash -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="transition-colors duration-300">
    <div class="min-h-screen bg-surface-light dark:bg-surface-dark transition-colors duration-300">
      <slot />
    </div>
    <Analytics/>
  </body>
</html>

<style is:global>
  /* Better focus styles */
  :focus-visible {
    @apply outline-none ring-2 ring-primary-500 ring-offset-2;
  }

  .dark :focus-visible {
    @apply ring-offset-surface-dark;
  }
</style>
